# Dockerfile.client — Pinpoint Rust desktop client (Linux target)
# Same multi-stage build as archived Dockerfile; desktop GUI (eframe/egui)
# needs X11 at runtime. Prefer native cargo run on Windows/macOS.

ARG RUST_VERSION=1.81
ARG DEBIAN_VERSION=bookworm-slim

FROM rust:bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      pkg-config \
      libssl-dev \
      libxcb-render0-dev \
      libxcb-shape0-dev \
      libxcb-xfixes0-dev \
      libxkbcommon-dev \
      libxkbcommon-x11-dev \
      libgl1-mesa-dev \
      libfontconfig1-dev \
      libfreetype6-dev \
      libxcb1-dev \
      libxcb-dri3-dev \
      libxcb-present-dev \
      libxcb-render-util0-dev \
      libxcb-icccm4-dev \
      libxcb-keysyms1-dev \
      libxcb-xinerama0-dev \
      libxrandr-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY tests ./tests
RUN cargo build --locked --release --bin pinpoint-desktop

FROM debian:${DEBIAN_VERSION} AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      libssl3 \
      libxcb1 \
      libxkbcommon0 \
      libxcb-render0 \
      libxcb-shape0 \
      libxcb-xfixes0 \
      libgl1 \
      libfontconfig1 \
      libfreetype6 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r pinpoint && useradd -r -g pinpoint -d /home/pinpoint -s /sbin/nologin pinpoint

WORKDIR /app
COPY --from=builder /build/target/release/pinpoint-desktop /app/pinpoint-desktop

ENV PINPOINT_BACKEND=http://host.docker.internal:8000
ENV PINPOINT_DATA_DIR=/home/pinpoint/.pinpoint

USER pinpoint
ENTRYPOINT ["/app/pinpoint-desktop"]
CMD ["--backend", "http://host.docker.internal:8000"]

FROM builder AS tester
WORKDIR /build
COPY . ./
CMD ["sh", "-c", "cargo fmt --all -- --check && cargo clippy --all-targets -- -D warnings && cargo build --locked && cargo test --locked"]
