<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.pinpoint.desktop">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Location: publish/share is manual lat/lon today; the permission below
         is required for future GPS publish. `accessFineLocation` must be
         paired with a Play Data-safety declaration before store listing. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <application
        android:label="Pinpoint"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.Light">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Cleartext is blocked except for the dev-host allowlist
             (10.0.2.2 emulator + localhost). Release builds must use HTTPS
             (ADR-0006) — see network_security_config.xml. -->
        <uses-sdk android:minSdkVersion="26"/>
    </application>
</manifest>
