<network-security-config>
  <!-- Debug/emulator only: the Rust client dev default is
       http://10.0.2.2:8000 (emulator host loopback) / http://localhost:8000.
       Release builds talk to HTTPS so the cleartext allowlist must never
       widen beyond these hosts. -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">10.0.2.2</domain>
    <domain includeSubdomains="true">localhost</domain>
  </domain-config>
</network-security-config>
