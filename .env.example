# Pinpoint — example environment (copy to .env; never commit real secrets)

# ---------------------------------------------------------------------------
# OSM services — self-host in production (ADR-0011). The public URLs below are
# demo defaults only; set your own infrastructure URLs before real traffic.
# See docs/maps/self-hosted-osm.md.
# ---------------------------------------------------------------------------
PINPOINT_NOMINATIM_URL=https://nominatim.openstreetmap.org
PINPOINT_OSRM_URL=https://router.project-osrm.org
PINPOINT_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Tile template, e.g. https://tiles.example.com/{z}/{x}/{y}.png
PINPOINT_TILE_URL=
# Optional CARTO key (only for the demo CARTO fallback)
CARTO_API_KEY=

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
BIND_ADDR=127.0.0.1:8000
# Empty = in-memory demo mode; set for Postgres persistence.
DATABASE_URL=
# Session/JWT signing material.
SECRET_KEY=
JWT_SECRET=
# Column-encryption KEK + blind-index key (database design, ADR-0010).
DATA_ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# ---------------------------------------------------------------------------
# Client
# ---------------------------------------------------------------------------
PINPOINT_BACKEND=http://localhost:8000
# Optional deterministic GPS fix for dev/testing: "lat,lon,acc" or JSON.
PINPOINT_GPS_FIX=
